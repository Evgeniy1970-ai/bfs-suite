          "id": "5ab6c826-6827-4bea-8a51-9cf2d0cb254a",
          "name": "When Document Uploaded",
          "webhookId": "YOUR_WEBHOOK_ID"
        },
        {
          "parameters": {
            "jsCode": "const body = $input.first().json.body;\n\nconst title = body.title;\nconst content = body.content;\nconst agentType = body.agent_type;\nconst isPublic = body.is_public || false;\nconst clientId = body.client_id;\n\nif (!title || !content || !agentType) {\n  throw new Error('Missing required fields: title, content, agent_type');\n}\n\nreturn [{\n  json: {\n    title,\n    content,\n    agent_type: agentType,\n    is_public: isPublic,\n    client_id: clientId,\n    metadata: JSON.stringify({\n      title,\n      is_public: isPublic,\n      agent_type: agentType\n    })\n  }\n}];"
          },
          "type": "n8n-nodes-base.code",
          "typeVersion": 2,
          "position": [
            208,
            0
          ],
          "id": "9ffd6177-5880-4d2f-9217-8b1c48be6687",
          "name": "Prepare Upload Data"
        },
        {
          "parameters": {
            "method": "POST",
            "url": "https://api.openai.com/v1/embeddings",
            "authentication": "genericCredentialType",
            "genericAuthType": "httpHeaderAuth",
            "sendBody": true,
            "specifyBody": "json",
            "jsonBody": "={\n  \"input\": \"={{ $json.content }}\",\n  \"model\": \"text-embedding-3-small\"\n}",
            "options": {}
          },
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.4,
          "position": [
