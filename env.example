# ─────────────────────────────────────────
# BFS Suite — Environment Variables Template
# Copy this file to .env and fill in your values
# Never commit .env to version control
# ─────────────────────────────────────────

# ── Supabase ──────────────────────────────
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ── OpenAI ────────────────────────────────
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# ── Telegram (Escalation Bot) ─────────────
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# ── n8n ───────────────────────────────────
N8N_WEBHOOK_URL=YOUR_NGROK_OR_PUBLIC_URL
# Example: https://your-subdomain.ngrok-free.dev

# ── Dashboard ─────────────────────────────
# Public API key — used by the web widget (limited access)
BFS_PUBLIC_API_KEY=YOUR_PUBLIC_API_KEY

# Private API key — used by the internal dashboard (full access)
BFS_PRIVATE_API_KEY=YOUR_PRIVATE_API_KEY
